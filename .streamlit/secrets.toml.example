# ---------------------------------------------------------------------------
# Hugging Face token (required to download google/gemma-2b-it)
# Get yours at: https://huggingface.co/settings/tokens
# Make sure the token has at least READ access and you have accepted
# the Gemma model license at: https://huggingface.co/google/gemma-2b-it
# ---------------------------------------------------------------------------
HF_TOKEN = "hf_YOUR_TOKEN_HERE"
